{
  "description": "Codex adapter for the shared harness hooks. The same four scripts Claude Code loads from the plugin, reached here by repo-relative path into the vendored copy.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|apply_patch|mcp__.*(edit|write|create|apply|read).*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/vendor/harness/hooks/protect_paths.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root '.agents/vendor/harness/hooks/protect_paths.mjs')\"",
            "timeout": 30,
            "statusMessage": "Checking protected paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch|mcp__.*(edit|write|create|apply).*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/vendor/harness/hooks/format_edited.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root '.agents/vendor/harness/hooks/format_edited.mjs')\"",
            "timeout": 120,
            "statusMessage": "Formatting edited files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/vendor/harness/hooks/verify.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root '.agents/vendor/harness/hooks/verify.mjs')\"",
            "timeout": 600,
            "statusMessage": "Verifying Definition of Done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/vendor/harness/hooks/codex_session_learnings.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root '.agents/vendor/harness/hooks/codex_session_learnings.mjs')\"",
            "timeout": 3,
            "statusMessage": "Distilling session learnings"
          }
        ]
      }
    ]
  }
}
