{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded child task request",
  "description": "Task data only. Parent identity, approval, model routing, budgets and authority are assigned by the control plane.",
  "type": "object",
  "required": ["task", "mode", "paths", "role"],
  "additionalProperties": false,
  "properties": {
    "task": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["read-only", "isolated-write"]},
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "role": {"type": "string", "enum": ["test_designer", "builder", "diagnoser", "documenter"]}
  }
}
